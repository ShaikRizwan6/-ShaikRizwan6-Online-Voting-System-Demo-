# Server Configuration
PORT=3000
NODE_ENV=development

# MySQL Database Configuration
# Default local development credentials (e.g. XAMPP, MySQL Server)
# If using XAMPP/WAMP, DB_PASSWORD is usually empty.
# If using MySQL Workbench/Installer, set your root password.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=online_voting_system

# Session Security Configuration
SESSION_SECRET=super_secure_voting_system_session_secret_change_me_in_prod
